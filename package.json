{
  "name": "bernos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1=DB",
    "pages:deploy": "wrangler pages deploy dist",
    "d1:init:local": "wrangler d1 execute bernos-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute bernos-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vue-tsc": "^3.3.5",
    "wrangler": "^4.151.0"
  }
}
